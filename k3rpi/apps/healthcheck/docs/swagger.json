{
    "swagger": "2.0",
    "info": {
        "description": "Liveness endpoint for the k3rpi cluster.",
        "title": "Healthcheck API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/api/v1",
